<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <record id="attendance_session_tree_view"
            model="ir.ui.view">

        <field name="name">attendance.session.tree</field>

        <field name="model">attendance.session</field>

        <field name="arch" type="xml">

            <list>

                <field name="name"/>
                <field name="start_datetime"/>
                <field name="end_datetime"/>
                <field name="state"/>
                <field name="attendance_count"/>

            </list>

        </field>

    </record>


    <record id="attendance_session_form_view"
            model="ir.ui.view">

        <field name="name">attendance.session.form</field>

        <field name="model">attendance.session</field>

        <field name="arch" type="xml">

            <form>
                <header>

                    <button
                            name="action_activate"
                            string="Activate"
                            type="object"
                            class="btn-primary"/>

                    <button
                            name="action_start_scan"
                            string="Scan Attendance"
                            type="object"
                            class="btn-primary"/>

                    <button
                            name="action_complete"
                            string="Complete"
                            type="object"/>

                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                        <field name="start_datetime"/>
                        <field name="end_datetime"/>
                        <field name="state"/>
                    </group>

                    <notebook>
                        <page string="Attendance">
                            <field name="attendance_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>

    </record>


    <record id="attendance_session_action"
            model="ir.actions.act_window">

        <field name="name">Sessions</field>

        <field name="res_model">attendance.session</field>

        <field name="view_mode">list,form</field>

    </record>

</odoo>