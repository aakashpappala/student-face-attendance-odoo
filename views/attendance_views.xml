<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <record id="attendance_tree_view"
            model="ir.ui.view">

        <field name="name">student.attendance.tree</field>

        <field name="model">student.attendance</field>

        <field name="arch" type="xml">

            <list>

                <field name="student_id"/>
                <field name="attendance_datetime"/>
                <field name="status"/>
                <field name="confidence_score"/>
                <field name="recognition_method"/>

            </list>

        </field>

    </record>


    <record id="attendance_form_view"
            model="ir.ui.view">

        <field name="name">student.attendance.form</field>

        <field name="model">student.attendance</field>

        <field name="arch" type="xml">

            <form>

                <sheet>

                    <group>

                        <field name="student_id"/>
                        <field name="session_id"/>

                        <field name="attendance_datetime"/>

                        <field name="status"/>

                        <field name="confidence_score"/>

                        <field name="recognition_method"/>

                    </group>

                </sheet>

            </form>

        </field>

    </record>


    <record id="attendance_action"
            model="ir.actions.act_window">

        <field name="name">Attendance</field>

        <field name="res_model">student.attendance</field>

        <field name="view_mode">list,form</field>

    </record>

</odoo>