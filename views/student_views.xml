<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <!-- Tree View -->

    <record id="student_tree_view" model="ir.ui.view">
        <field name="name">student.student.tree</field>
        <field name="model">student.student</field>

        <field name="arch" type="xml">
            <list>

                <field name="name"/>
                <field name="roll_no"/>
                <field name="branch"/>
                <field name="year"/>
                <field name="face_registered"/>

            </list>
        </field>
    </record>


    <!-- Form View -->

    <record id="student_form_view" model="ir.ui.view">
        <field name="name">student.student.form</field>
        <field name="model">student.student</field>

        <field name="arch" type="xml">
            <form>

                <sheet>

                    <header>

                        <button
                                name="action_capture_face"
                                type="object"
                                string="Capture Face"
                                class="btn-primary"/>

                    </header>

                    <group>

                        <group>

                            <field name="name"/>
                            <field name="roll_no"/>
                            <field name="branch"/>
                            <field name="year"/>

                        </group>

                        <group>

                            <field name="image" widget="image"/>

                            <field name="face_registered"
                                   readonly="1"/>

                            <field name="face_count"
                                   readonly="1"/>

                        </group>

                    </group>

                    <notebook>

                        <page string="Face Images">

                            <field name="face_ids">

                                <list>

                                    <field name="capture_date"/>
                                    <field name="quality_score"/>
                                    <field name="eyes_visible"/>

                                </list>

                            </field>

                        </page>

                        <page string="Attendance">

                            <field name="attendance_ids">

                                <list>

                                    <field name="attendance_datetime"/>
                                    <field name="status"/>
                                    <field name="confidence_score"/>

                                </list>

                            </field>

                        </page>

                    </notebook>

                </sheet>

            </form>
        </field>
    </record>


    <!-- Action -->

    <record id="student_action"
            model="ir.actions.act_window">

        <field name="name">Students</field>

        <field name="res_model">student.student</field>

        <field name="view_mode">list,form</field>

    </record>

</odoo>